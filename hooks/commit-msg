#!/usr/bin/env python3
"""The change loop's checks on a commit about to be made (lib/checks.py)."""

from pathlib import Path
import fnmatch
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
import checks  # noqa: E402

EXAMPLE = """\
Example: the last paragraph of the message, one trailer a line:

    Issue: F17
    Evidence: data sheet: SBG 6-12, a 14h block ends on its last byte
    Evidence: emulator: plan 3f2a91c4, 18 runs, all passed (ledger), D10 against D9: F17 gone
    Evidence: hardware: the PC, D10 kit, Jill on the CT2290

Or, for a change the binaries do not see:

    Issue: F17
    Evidence: none: comments at the join labels"""


def message_text(path):
    # What git will store: comment lines and everything after the scissors go.
    lines = []
    for line in Path(path).read_text().splitlines():
        if line.startswith('# ') and '>8' in line:
            break
        if not line.startswith('#'):
            lines.append(line)
    return '\n'.join(lines).strip() + '\n'


def main(path):
    branch = checks.git('symbolic-ref', '-q', '--short', 'HEAD', check=False).stdout.strip()
    if any(fnmatch.fnmatchcase(branch, pattern)
           for pattern in checks.CONFIG['commit']['skip_branches']):
        return 0
    problems, code = checks.check(message_text(path), checks.Target())
    if not problems:
        return 0
    shown = ', '.join(code[:4]) + (', ...' if len(code) > 4 else '')
    print('commit-msg: refused' + (f'; this commit changes code ({shown})' if code else ''),
          file=sys.stderr)
    for problem in problems:
        print(f'  - {problem}', file=sys.stderr)
    if code:
        print('\n' + EXAMPLE, file=sys.stderr)
    kept = checks.git('rev-parse', '--git-path', 'COMMIT_EDITMSG').stdout.strip()
    print(f'\nThe message is kept in {kept}.', file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1]))
